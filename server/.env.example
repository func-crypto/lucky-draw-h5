# LuckyDraw production example
PORT=3000
NODE_ENV=production

# 身份模式：正式上线使用 wechat；本地开发默认 dev
IDENTITY_MODE=wechat

# 必填：正式后台口令，请替换为随机强口令
ADMIN_KEY=replace-with-a-strong-admin-key

# SQLite 数据文件；部署时请持久化并定期备份此目录
DATA_FILE=./data/lucky-draw.sqlite

# 微信公众号网页授权
PUBLIC_BASE_URL=https://lottery.example.com
WECHAT_APP_ID=wx-your-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret

# 用于签名 OAuth state 和 HttpOnly 用户会话；请使用随机强字符串
SESSION_SECRET=replace-with-a-long-random-session-secret
